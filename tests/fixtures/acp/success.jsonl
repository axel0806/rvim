{"spec": "ACP v1. Initialization: initialize, protocolVersion, clientCapabilities, clientInfo, agentCapabilities (https://agentclientprotocol.com/protocol/initialization). Session setup: session/new, sessionId (/protocol/session-setup). Prompt turn: session/prompt, session/update agent_message_chunk, agent_thought_chunk, tool_call, tool_call_update, plan, stopReason end_turn (/protocol/prompt-turn). Schema v1 SessionUpdate, StopReason."}
{"event": "connect", "cwd": "/home/user/project", "at": 0, "expect": [{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": false, "writeTextFile": false}, "terminal": false}, "clientInfo": {"name": "rvim", "version": "<any>"}}}}], "state": "Initializing"}
{"event": "bytes", "at": 5, "in": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": false, "promptCapabilities": {"image": false, "audio": false, "embeddedContext": false}}, "authMethods": []}}, "expect": [{"send": {"jsonrpc": "2.0", "id": 2, "method": "session/new", "params": {"cwd": "/home/user/project", "mcpServers": []}}}], "state": "Initializing"}
{"event": "bytes", "at": 10, "in": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "sess_abc123"}}, "expect": [{"notice": "connected", "session": "sess_abc123"}], "state": "Ready"}
{"event": "prompt", "at": 20, "text": "Fix the typo on line 3", "expect": [{"send": {"jsonrpc": "2.0", "id": 3, "method": "session/prompt", "params": {"sessionId": "sess_abc123", "prompt": [{"type": "text", "text": "Fix the typo on line 3"}]}}}, {"notice": "turn_started", "turn": 1}], "state": "Prompting"}
{"event": "bytes", "at": 30, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Looking at "}}}}, "expect": [{"update": "agent_message_chunk", "text": "Looking at "}], "state": "Prompting"}
{"event": "bytes", "at": 31, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "line 3."}}}}, "expect": [{"update": "agent_message_chunk", "text": "line 3."}], "state": "Prompting"}
{"event": "bytes", "at": 32, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "agent_thought_chunk", "content": {"type": "text", "text": "Check the buffer first."}}}}, "expect": [{"update": "agent_thought_chunk", "text": "Check the buffer first."}], "state": "Prompting"}
{"event": "bytes", "at": 33, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "tool_call", "toolCallId": "call_1", "title": "Read src/a.rs", "kind": "read", "status": "pending"}}}, "expect": [{"update": "tool_call", "id": "call_1", "title": "Read src/a.rs", "status": "pending"}], "state": "Prompting"}
{"event": "bytes", "at": 34, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "tool_call_update", "toolCallId": "call_1", "status": "completed", "content": [{"type": "content", "content": {"type": "text", "text": "ok"}}]}}}, "expect": [{"update": "tool_call_update", "id": "call_1", "title": null, "status": "completed"}], "state": "Prompting"}
{"event": "bytes", "at": 35, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "plan", "entries": [{"content": "Find the typo", "priority": "high", "status": "completed"}, {"content": "Fix it", "priority": "medium", "status": "in_progress"}]}}}, "expect": [{"update": "plan", "entries": [{"content": "Find the typo", "priority": "high", "status": "completed"}, {"content": "Fix it", "priority": "medium", "status": "in_progress"}]}], "state": "Prompting"}
{"event": "bytes", "at": 40, "in": {"jsonrpc": "2.0", "id": 3, "result": {"stopReason": "end_turn"}}, "expect": [{"notice": "turn_ended", "turn": 1, "stop": "end_turn"}], "state": "Ready"}
