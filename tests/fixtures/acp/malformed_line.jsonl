{"spec": "ACP v1 transports (https://agentclientprotocol.com/protocol/transports): newline-delimited JSON-RPC 2.0, UTF-8, no embedded newlines; the agent MUST NOT write anything to stdout that is not a valid ACP message. rvim's rule (not in the spec): a malformed line is logged and skipped; MAX_MALFORMED_IN_A_ROW (10) in a row disconnect (the 10-line case is a unit test in tests/acp_connector.rs)."}
{"event": "connect", "cwd": "/home/user/project", "at": 0, "expect": [{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": true, "writeTextFile": true}, "terminal": false}, "clientInfo": {"name": "rvim", "version": "<any>"}}}}], "state": "Initializing"}
{"event": "bytes", "at": 5, "in": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "agentCapabilities": {}, "authMethods": []}}, "expect": [{"send": {"jsonrpc": "2.0", "id": 2, "method": "session/new", "params": {"cwd": "/home/user/project", "mcpServers": []}}}], "state": "Initializing"}
{"event": "bytes", "at": 10, "in": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "sess_abc123"}}, "expect": [{"notice": "connected", "session": "sess_abc123"}], "state": "Ready"}
{"event": "prompt", "at": 20, "text": "Hi", "expect": [{"send": {"jsonrpc": "2.0", "id": 3, "method": "session/prompt", "params": {"sessionId": "sess_abc123", "prompt": [{"type": "text", "text": "Hi"}]}}}, {"notice": "turn_started", "turn": 1}], "state": "Prompting"}
{"event": "bytes", "at": 30, "raw": "this is not json\n", "expect": [], "state": "Prompting"}
{"event": "bytes", "at": 31, "raw": "[1,2]\n\n   \n", "expect": [], "state": "Prompting"}
{"event": "bytes", "at": 32, "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"session/update\",\"params\":{\"sessionId\":\"sess_abc123\",\"update\":{\"sessionUpdate\":\"agent_message_chunk\",\"content\":{\"type\":\"text\",\"text\":\"still here\"}}}}\n", "expect": [{"update": "agent_message_chunk", "text": "still here"}], "state": "Prompting"}
{"event": "bytes", "at": 40, "in": {"jsonrpc": "2.0", "id": 3, "result": {"stopReason": "end_turn"}}, "expect": [{"notice": "turn_ended", "turn": 1, "stop": "end_turn"}], "state": "Ready"}
