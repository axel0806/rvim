{"spec": "ACP v1 has no EOF rule; the PLAN.md rule (section 2 and 10): EOF during a turn ends the turn with 'connection lost', state Disconnected, and the turn is not resumed on reconnect."}
{"event": "connect", "cwd": "/home/user/project", "at": 0, "expect": [{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": true, "writeTextFile": true}, "terminal": false}, "clientInfo": {"name": "rvim", "version": "<any>"}}}}], "state": "Initializing"}
{"event": "bytes", "at": 5, "in": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "agentCapabilities": {}, "authMethods": []}}, "expect": [{"send": {"jsonrpc": "2.0", "id": 2, "method": "session/new", "params": {"cwd": "/home/user/project", "mcpServers": []}}}], "state": "Initializing"}
{"event": "bytes", "at": 10, "in": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "sess_abc123"}}, "expect": [{"notice": "connected", "session": "sess_abc123"}], "state": "Ready"}
{"event": "prompt", "at": 20, "text": "Long task", "expect": [{"send": {"jsonrpc": "2.0", "id": 3, "method": "session/prompt", "params": {"sessionId": "sess_abc123", "prompt": [{"type": "text", "text": "Long task"}]}}}, {"notice": "turn_started", "turn": 1}], "state": "Prompting"}
{"event": "bytes", "at": 30, "in": {"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": "sess_abc123", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Working"}}}}, "expect": [{"update": "agent_message_chunk", "text": "Working"}], "state": "Prompting"}
{"event": "eof", "at": 40, "expect": [{"notice": "connection_lost", "turn": 1}], "state": "Disconnected"}
{"event": "bytes", "at": 41, "in": {"jsonrpc": "2.0", "id": 3, "result": {"stopReason": "end_turn"}}, "expect": [], "state": "Disconnected"}
{"event": "connect", "cwd": "/home/user/project", "at": 50, "expect": [{"send": {"jsonrpc": "2.0", "id": 4, "method": "initialize", "params": {"protocolVersion": 1, "clientCapabilities": {"fs": {"readTextFile": true, "writeTextFile": true}, "terminal": false}, "clientInfo": {"name": "rvim", "version": "<any>"}}}}], "state": "Initializing"}
